// DDOSD (NSDI Table 2): Window Label Collision
//
// DDOSD tracks the current observation window in a 32-bit counter (`ow_counter`),
// but stores only the low 8 bits (`current_ow[7:0]`) as a per-cell label in the
// CountSketch observation-window arrays (`*_ow`).
//
// When the low 8 bits collide across distinct windows, stale CountSketch values
// may be treated as if they belonged to the current window (i.e., the per-cell
// reset is skipped).
//
// This spec seeds a collision directly via control-plane init:
//   - set `ow_counter = 256` (so `current_ow[7:0] == 0`),
//   - set `src_cs1[0] = 1` and `src_cs1_ow[0] = 0` as a stale sketch cell.
// A single packet that hashes to index 0 will then treat the stale value as
// "current" and increment it to 2 (deterministic hash/sign mode).

import s1 from "../../dataset/DDOSD/src/ddosd_procurator_det.p4"
  entries "../../dataset/DDOSD/scripts/control_rules_window_collision_seed.txt";

topology {}

host io {
  connect s1;
  env {
    hdr.ethernet.valid = true;
    hdr.ipv4.valid = true;
    hdr.ethernet.ether_type = 2048; // 0x0800 IPv4

    // Deterministic hash mode maps index := src_addr & 1, so pick an even src_addr
    // to force CountSketch row index 0.
    hdr.ipv4.src_addr = 2;
    hdr.ipv4.dst_addr = 1;
  }
}

global {
  queue_capacity = 1;
  deterministic_scheduler = true;
  env_thread = false;
  host_eager = true;
  // Deterministic schedule in the sequential harness executes:
  //   step0: host_send (enqueue to s1)
  //   step1: host_recv (optional)
  //   step2: node_pass (consume + process)
  max_steps = 3;

  // If the low-8-bit window label collides, the stale value 1 is treated as current
  // and incremented to 2 (instead of being reset to 0 and becoming +/-1).
  assert { s1_ingress_src_cs1[0] <= 1; };
}
