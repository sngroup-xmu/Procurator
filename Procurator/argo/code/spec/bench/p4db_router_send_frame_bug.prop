// P4DB (router test): potential send_frame match-key bug (egress_port vs egress_spec).
//
// The router pipeline sets the next hop and output port in ingress, then tries to
// set the source MAC based on the selected port. In the test program, the
// `send_frame` table matches on `standard_metadata.egress_port`, while the pipeline
// sets `standard_metadata.egress_spec`. On many targets, `egress_port` is not set
// during ingress, so `send_frame` may miss and fail to set the source MAC (or drop).
//
// This spec drives a simple IPv4 packet through the pipeline and asserts that the
// source MAC is set as expected for port 1. Any UNSAFE result must be validated by
// witness rerun.

import sw from "../../dataset/P4DB/tests/router/router.p4"
  entries "../../dataset/P4DB/tests/router/commands";

topology {}

host io {
  connect sw;
  env {
    // IPv4 packet for dst 10.0.0.1 (/32) with ttl > 0.
    // NOTE: The exact header namespace depends on the P4 front-end; if compilation
    // fails, adjust these field names to match the generated Boogie variables.
    hdr.ethernet.valid = true;
    hdr.ipv4.valid = true;
    hdr.ethernet.etherType = 2048; // ETHERTYPE_IPV4
    hdr.ipv4.ttl = 2;
    hdr.ipv4.dstAddr = 167772161; // 10.0.0.1
    hdr.ipv4.srcAddr = 167772162; // 10.0.0.2

    // Make the effect of set_smac observable.
    hdr.ethernet.srcAddr = 0;
    hdr.ethernet.dstAddr = 0;

    // Port-forwarding entries map ingress_port 1 -> output port 1.
    standard_metadata.ingress_port = 1;
  }
}

global {
  queue_capacity = 1;
  env_thread = false;
  host_eager = true;
  deterministic_scheduler = true;
  max_steps = 3;

  // Expected behavior: packet routed to port 1 and source MAC rewritten accordingly.
  assert {
    (sw_standard_metadata.egress_spec == 1)
      && (sw_hdr.ethernet.srcAddr == 140883517308929);
  };
}

