// Gecko bug #3 (ta-only): write arrives before timer is active.
// Reduced to single pipeline to isolate translation correctness and trace sanity.

import ta from "/mnt/e/p4-verify/Procurator/argo/code/dataset/gecko/timer_a.json" entries "/mnt/e/p4-verify/Procurator/argo/code/dataset/gecko/control/a.txt";

topology {
  // ta-only model: no inter-node forwarding
}

host io {
  connect ta;
  env {
    hdr.ethernet.ether_type = 21845;
    hdr.albion.CS_id_1 = 0;
    hdr.albion.CS_id_2 = 0;
    hdr.albion.CS_id_3 = 0;
    hdr.albion.CS_offset_1 = 0;
    hdr.albion.CS_offset_2 = 0;
    hdr.albion.CS_offset_3 = 0;
    hdr.albion.address_h = 0;
    hdr.albion.address_l = 0;
    hdr.albion.index = 0;
    hdr.albion.num = 0;
    hdr.albion.port = 0;
    hdr.albion.request_id_high = 0;
    hdr.albion.request_id_low = 0;
    hdr.albion.time = 0;
    hdr.albion_data.data_0 = 0;
    hdr.albion_data.data_1 = 0;
    hdr.albion_data.data_2 = 0;
    hdr.albion_data.data_3 = 0;
    hdr.albion_data.data_4 = 0;
    hdr.albion_data.data_5 = 0;
    hdr.albion_data.data_6 = 0;
    hdr.albion_data.data_7 = 0;
    hdr.albion_data.data_8 = 0;
    hdr.albion_data.data_9 = 0;
    hdr.albion_data.data_10 = 0;
    hdr.albion_data.data_11 = 0;
    hdr.ethernet.valid = true;
    hdr.albion.valid = true;
    if (phase == 0) {
      hdr.albion.operation = 10;
      phase = 1;
    } else {
      hdr.albion.operation = 100;
    }
    if (hdr.albion.operation == 100) {
      hdr.albion_timer.valid = true;
      hdr.albion_data.valid = false;
    } else {
      hdr.albion_timer.valid = false;
      hdr.albion_data.valid = true;
    }
  }
}

node ta {
  external_input = false;
  assume {
    hdr.ethernet.ether_type == 21845;
    hdr.albion.CS_id_1 == 0;
    hdr.albion.CS_id_2 == 0;
    hdr.albion.CS_id_3 == 0;
    hdr.albion.CS_offset_1 == 0;
    hdr.albion.CS_offset_2 == 0;
    hdr.albion.CS_offset_3 == 0;
    hdr.albion.address_h == 0;
    hdr.albion.address_l == 0;
    hdr.albion.index == 0;
    hdr.albion.num == 0;
    hdr.albion.port == 0;
    hdr.albion.request_id_high == 0;
    hdr.albion.request_id_low == 0;
    hdr.albion.time == 0;
    hdr.albion_data.data_0 == 0;
    hdr.albion_data.data_1 == 0;
    hdr.albion_data.data_2 == 0;
    hdr.albion_data.data_3 == 0;
    hdr.albion_data.data_4 == 0;
    hdr.albion_data.data_5 == 0;
    hdr.albion_data.data_6 == 0;
    hdr.albion_data.data_7 == 0;
    hdr.albion_data.data_8 == 0;
    hdr.albion_data.data_9 == 0;
    hdr.albion_data.data_10 == 0;
    hdr.albion_data.data_11 == 0;
    hdr.albion_data.valid == false;
    (hdr.albion.operation == 10 || hdr.albion.operation == 100);
  };
  if (hdr.albion.operation == 100) {
    timer_active = 1;
  }
  if (hdr.albion.operation == 10 && timer_active == 0) {
    bad = 1;
  }
  if (ig_tm_md.ucast_egress_port == 144) {
    client_seen = 1;
  }
}

global {
  queue_capacity = 1;
  env_thread = false;
  host_eager = true;
  int timer_active = 0;
  int bad = 0;
  int client_seen = 0;
  int phase = 0;
  assume {
    ta_aIngress_register_address_h_record_0[0] == ta_aIngress_register_address_h_record_0[0];
    ta_aIngress_register_address_h_record_1[0] == ta_aIngress_register_address_h_record_1[0];
    ta_aIngress_register_address_h_record_2[0] == ta_aIngress_register_address_h_record_2[0];
    ta_aIngress_register_address_h_record_3[0] == ta_aIngress_register_address_h_record_3[0];
    ta_aIngress_register_address_l_record_0[0] == ta_aIngress_register_address_l_record_0[0];
    ta_aIngress_register_address_l_record_1[0] == ta_aIngress_register_address_l_record_1[0];
    ta_aIngress_register_address_l_record_2[0] == ta_aIngress_register_address_l_record_2[0];
    ta_aIngress_register_address_l_record_3[0] == ta_aIngress_register_address_l_record_3[0];
    ta_aIngress_register_state_0[0] == ta_aIngress_register_state_0[0];
    ta_aIngress_register_state_1[0] == ta_aIngress_register_state_1[0];
    ta_aIngress_register_state_2[0] == ta_aIngress_register_state_2[0];
    ta_aIngress_register_state_3[0] == ta_aIngress_register_state_3[0];
    ta_aIngress_register_num[0] == ta_aIngress_register_num[0];
    ta_aIngress_register_request_id_high[0] == ta_aIngress_register_request_id_high[0];
    ta_aIngress_register_request_id_low[0] == ta_aIngress_register_request_id_low[0];
    ta_aIngress_register_timer[0] == ta_aIngress_register_timer[0];
  };
  assert {
    bad == 0;
  };
}
