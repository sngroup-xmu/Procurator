// P4NIS (NSDI Table 2): Bug 1 - Forwarding Sequence Desync
//
// This spec drives the in-program @assert:
//   standard_metadata.egress_spec == 1 || 2 || 3
// by seeding `count` to an unexpected value (3), which prevents the program
// from selecting any of the three forwarding branches.

import s1 from "../../dataset/P4NIS/P4NIS.p4"
  entries "../../dataset/P4NIS/commands_bug1_forwarding_sequence_desync_seed.txt";

topology {}

node s1 {
  external_input = true;
  assume {
    // Drive the "user packet" path.
    standard_metadata.ingress_port == 0;
    // Make the bug deterministic: if no forwarding branch runs, egress_spec stays 0.
    standard_metadata.egress_spec == 0;
    standard_metadata.egress_port == 0;

    hdr.ethernet.valid == true;
    hdr.ipv4.valid == true;
    hdr.tcp.valid == true;

    // Avoid the special DNS fast-path.
    hdr.ipv4.dstAddr != 2071690107;

    // Ensure the main processing branch is taken.
    hdr.ethernet.dstAddr != 281474976710655;
    hdr.ethernet.srcAddr != 0;
  };
}

global {
  queue_capacity = 1;
  deterministic_scheduler = true;
  max_steps = 2;

  // Expected behavior: user packets must be forwarded to one of the three analysis paths.
  assert {
    (s1_standard_metadata.ingress_port != 0)
      || (s1_standard_metadata.egress_spec == 1)
      || (s1_standard_metadata.egress_spec == 2)
      || (s1_standard_metadata.egress_spec == 3);
  };
}
