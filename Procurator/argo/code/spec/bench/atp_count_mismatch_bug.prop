// ATP: aggregation count mismatch under packet loss (NSDI Table 1).
//
// Property (paper): Aggregation Count Mismatch
// Root cause (paper): Packet loss leads to fewer completed aggregations.
//
// We encode a minimal, functional safety check that exposes a state-loss bug under
// the resend path:
//   - Packet 1 (normal): a new worker bitmap bit arrives and is recorded in the
//     in-switch bitmap register.
//   - Packet 2 (resend): due to loss, a different worker resends; the program
//     clears the bitmap register to 0 but never writes the resent bitmap back,
//     losing progress and making completion impossible.
//
// Safety statement: after two externally injected (valid) ATP packets for the same
// aggregator index, the bitmap register should equal the union of both bits (3),
// i.e., progress is monotonic.

import s1 from "../../dataset/ATP/p4src/p4ml_lc_16.p4"
  entries "../../dataset/ATP/p4src/atp/flow.txt";

topology {}

node s1 {
  // Count externally injected ATP packets that actually take the p4ml path.
  int processed = 0;
  if (pkt_external && hdr.p4ml.valid) {
    processed += 1;
  }
}

host io {
  connect s1;
  env {
    // Mark headers as present (P4 ingress guards on hdr.p4ml.isValid()).
    hdr.ethernet.valid = true;
    hdr.ipv4.valid = true;
    hdr.udp.valid = true;
    hdr.p4ml.valid = true;
    hdr.p4ml_agtr_index.valid = true;
    hdr.p4ml_entries.valid = true;

    // Make the request parse as ATP: ethertype=0x0800 and UDP dst_port=6001.
    hdr.ethernet.ether_type = 2048; // 0x0800
    hdr.udp.dst_port = 6001;

    // Fixed aggregator index (so we reason about a single register slot).
    hdr.p4ml_agtr_index.agtr = 0;

    // Keep appID/seq stable (register is initially 0).
    hdr.p4ml.appIDandSeqNum = 1;

    // Common fields (not ACK, no overflow).
    hdr.p4ml.isACK = 0;
    hdr.p4ml.overflow = 0;
    hdr.p4ml.isSWCollision = 0;
    hdr.p4ml.ECN = 0;
    hdr.p4ml.dataIndex = 0;
    hdr.p4ml.PSIndex = 0;

    // Two-packet host script:
    //   phase 0: normal packet for worker bit 0x1
    //   phase 1: resend packet for worker bit 0x2 (lost before, so resent)
    if (phase == 0) {
      hdr.p4ml.isResend = 0;
      hdr.p4ml.bitmap = 1;
      // In the normal path, agtr_time is incremented to 1 before being compared.
      hdr.p4ml.agtr_time = 1;
      phase = 1;
    } else {
      hdr.p4ml.isResend = 1;
      hdr.p4ml.bitmap = 2;
      // In the resend path, meta.agtr_time is set from hdr.p4ml.agtr_time directly.
      hdr.p4ml.agtr_time = 1;
    }

    // Deterministic entry payload (not required for the bitmap bug).
    hdr.p4ml_entries.data0 = 0;
    hdr.p4ml_entries.data1 = 0;
    hdr.p4ml_entries.data2 = 0;
    hdr.p4ml_entries.data3 = 0;
  }
}

global {
  queue_capacity = 1;
  deterministic_scheduler = true;
  env_thread = false;
  host_eager = true;
  // Two deterministic rounds are enough:
  //   round0: host_send(pkt1) -> node_pass
  //   round1: host_send(pkt2) -> node_pass
  max_steps = 6;

  // Host script state.
  int phase = 0;

  // Functional property:
  // After the second packet is processed, the bitmap register slot must equal 3.
  //
  // The buggy resend path clears the bitmap register to 0 and never writes back
  // the resent bitmap, so the union is lost.
  assert {
    (s1_dsl_processed < 2) || (s1_bitmap[0] == 3);
  };
}

