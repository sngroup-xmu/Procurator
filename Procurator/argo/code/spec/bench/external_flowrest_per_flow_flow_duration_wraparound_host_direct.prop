// External candidate: Flowrest INFOCOM 2023 per-flow Random Forest inference.
//
// Bug shape:
//   reg_flow_duration is a 32-bit accumulated duration feature.  Three packets
//   on the same flow can make non-zero inter-arrival updates wrap the duration
//   back to 0:
//     packet 1: timestamp 1 initializes reg_time_last_pkt and flow identity
//     packet 2: timestamp 2^32-1 adds a large IAT
//     packet 3: timestamp 1 adds 2 and wraps reg_flow_duration to 0
//
// The assertion is guarded only by the P4B write mirror. Since Flowrest does
// not write reg_flow_duration on the first-packet path, a violation requires an
// actual later write of zero.

import flowrest from "../../dataset/external_flowrest_per_flow/unsw_per_flow_16_classes.p4";

topology {}

host io {
  connect flowrest;
  env {
    hdr.ethernet.valid = true;
    hdr.ipv4.valid = true;
    hdr.tcp.valid = true;
    hdr.udp.valid = false;
    hdr.recirc.valid = false;

    hdr.ethernet.ether_type = 2048; // TYPE_IPV4
    hdr.ipv4.protocol = 6;          // TCP
    hdr.ipv4.total_len = 64;
    hdr.ipv4.src_addr = 167772161;  // 10.0.0.1
    hdr.ipv4.dst_addr = 167772162;  // 10.0.0.2
    hdr.tcp.src_port = 1234;
    hdr.tcp.dst_port = 443;
    meta.hdr_srcport = 1234;
    meta.hdr_dstport = 443;

    ig_intr_md.resubmit_flag = 0;

    if (phase == 0) {
      ig_prsr_md.global_tstamp = 1;
    } else {
      if (phase == 1) {
        ig_prsr_md.global_tstamp = 4294967295;
      } else {
        ig_prsr_md.global_tstamp = 1;
      }
    }

    hdr.ipv4.ttl = 64;
    phase += 1;
  }
}

global {
  queue_capacity = 1;
  env_thread = false;
  host_eager = true;
  deterministic_scheduler = true;
  max_steps = 9;

  int phase = 0;

  assert {
    !(flowrest_Ingress_reg_flow_duration__wrote_any
      && flowrest_Ingress_reg_flow_duration__last_value == 0);
  };
}
