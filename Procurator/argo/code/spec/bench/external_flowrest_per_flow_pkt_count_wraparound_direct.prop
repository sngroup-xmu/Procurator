// External candidate: Flowrest INFOCOM 2023 per-flow Random Forest inference.
//
// Bug shape:
//   reg_pkt_count is an 8-bit per-flow packet counter.  The register starts at
//   0 and read_pkt_count writes pkt_count + 1 on every packet for the flow; a
//   long-lived flow therefore wraps the feature value back to 0.
//
// This direct single-node spec avoids host scheduling noise. The assertion is
// guarded by the P4B register write mirror, so a counterexample must contain an
// actual zero write to reg_pkt_count.  `max_steps` is only a benchmark/debug
// hint; the default verifier path ignores it unless explicitly requested.

import flowrest from "../../dataset/external_flowrest_per_flow/unsw_per_flow_16_classes.p4";

topology {}

node flowrest {
  external_input = true;

  assume {
    hdr.ethernet.valid == true;
    hdr.ipv4.valid == true;
    hdr.tcp.valid == true;
    hdr.udp.valid == false;
    hdr.recirc.valid == false;

    hdr.ethernet.ether_type == 2048; // TYPE_IPV4
    hdr.ipv4.protocol == 6;          // TCP
    hdr.ipv4.total_len == 64;
    hdr.ipv4.src_addr == 167772161;  // 10.0.0.1
    hdr.ipv4.dst_addr == 167772162;  // 10.0.0.2
    hdr.tcp.src_port == 1234;
    hdr.tcp.dst_port == 443;

    ig_intr_md.resubmit_flag == 0;
    ig_prsr_md.global_tstamp == 1;
  };
}

global {
  queue_capacity = 1;
  deterministic_scheduler = true;
  max_steps = 260;

  assert {
    !(flowrest_Ingress_reg_pkt_count__wrote_any
      && flowrest_Ingress_reg_pkt_count__last_value == 0);
  };
}
