// Recirculation fan-out ordering bug (microbenchmark).
//
// Two writes A(write_id=0) and B(write_id=1) are fanned out to two replicas via
// recirculation. The first copy is sent based on a load-balancer decision
// (`hdr.fanout.primary`), and the second copy is sent on a later pass to the
// other replica. Because recirculation splits a logical broadcast into two
// passes, a schedule may produce a send/arrival pattern like:
//   A, B, A', B'
// where A'/B' are recirculated copies. This yields inconsistent ordering across
// replicas: S1 observes A->B while S2 observes B->A.

import t from "../../dataset/recirc_fanout/switch.p4";
import s1 from "../../dataset/recirc_fanout/server.p4";
import s2 from "../../dataset/recirc_fanout/server.p4";

topology {
  link t -> s1 1;
  link t -> s2 2;
}

node t {
  external_input = true;

  // Inject alternating write IDs: A then B then A then B ...
  // LB choice is independent of write_id and is modeled as an unconstrained
  // header bit `hdr.fanout.primary` (havoc'ed by the harness at injection time).
  env {
    hdr.fanout.valid = true;
    hdr.fanout.pass = 0;
    if (phase == 0) {
      hdr.fanout.write_id = 0;
      phase = 1;
    } else {
      hdr.fanout.write_id = 1;
      phase = 0;
    }
  }
}

node s1 {
  // Observer/sink: no need to schedule a P4 pass on the server.
  // We record arrivals at enqueue-time and drop the packet.
  sink = true;
  // Record the first two arrivals at S1.
  if (hdr.fanout.valid == true) {
    if (hdr.fanout.write_id == 0) {
      if (s1_first == 2) {
        s1_first = 0;
      } else {
        if (s1_second == 2) { s1_second = 0; }
      }
    } else {
      if (s1_first == 2) {
        s1_first = 1;
      } else {
        if (s1_second == 2) { s1_second = 1; }
      }
    }
  }
}

node s2 {
  // Observer/sink: no need to schedule a P4 pass on the server.
  // We record arrivals at enqueue-time and drop the packet.
  sink = true;
  // Record the first two arrivals at S2.
  if (hdr.fanout.valid == true) {
    if (hdr.fanout.write_id == 0) {
      if (s2_first == 2) {
        s2_first = 0;
      } else {
        if (s2_second == 2) { s2_second = 0; }
      }
    } else {
      if (s2_first == 2) {
        s2_first = 1;
      } else {
        if (s2_second == 2) { s2_second = 1; }
      }
    }
  }
}

global {
  // This microbenchmark requires two distinct pending packets at T to reproduce
  // the A, B, A', B' ordering.
  queue_capacity = 2;
  // Bounded bug-finding: with single-pass (no two-stage) scheduling, the bug is
  // reachable in a small number of steps. If you keep the two-stage pipeline,
  // increase this bound accordingly.
  // Minimal schedule is 2 injections + 4 passes = 6 steps; keep a small slack.
  max_steps = 8;
  // Deterministic round-robin is sufficient here; the remaining nondet is the
  // Bag dequeue choice when two packets are pending.
  deterministic_scheduler = true;

  // DSL state: 2 means "unset" (write_id is 0/1).
  int phase = 0;
  int s1_first = 2;
  int s1_second = 2;
  int s2_first = 2;
  int s2_second = 2;

  assert {
    !(
      (s1_first == 0 && s1_second == 1 && s2_first == 1 && s2_second == 0) ||
      (s1_first == 1 && s1_second == 0 && s2_first == 0 && s2_second == 1)
    );
  };
}
