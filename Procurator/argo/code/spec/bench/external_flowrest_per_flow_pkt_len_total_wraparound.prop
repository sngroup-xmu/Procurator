// External candidate: Flowrest INFOCOM 2023 per-flow Random Forest inference.
//
// Bug shape:
//   reg_pkt_len_total is a 16-bit per-flow accumulated length feature.
//   Two 32768-byte packets on the same flow make the feature wrap to 0, so the
//   in-switch ML feature no longer represents the total observed bytes.
//
// The external P4 source is kept unchanged. Unsupported TNA/Tofino syntax must
// be handled in P4B rather than by modifying dataset/external_flowrest_per_flow.

import flowrest from "../../dataset/external_flowrest_per_flow/unsw_per_flow_16_classes.p4";

topology {}

host io {
  connect flowrest;
  env {
    hdr.ethernet.valid = true;
    hdr.ipv4.valid = true;
    hdr.tcp.valid = true;
    hdr.udp.valid = false;
    hdr.recirc.valid = false;

    hdr.ethernet.ether_type = 2048; // TYPE_IPV4
    hdr.ipv4.protocol = 6;          // TCP
    hdr.ipv4.total_len = 32768;     // two packets overflow the 16-bit total
    hdr.ipv4.src_addr = 167772161;  // 10.0.0.1
    hdr.ipv4.dst_addr = 167772162;  // 10.0.0.2
    hdr.tcp.src_port = 1234;
    hdr.tcp.dst_port = 443;
    meta.hdr_srcport = 1234;
    meta.hdr_dstport = 443;

    ig_intr_md.resubmit_flag = 0;
    ig_prsr_md.global_tstamp = 1;

    // Stable baseline so TTL observations are attributable to the P4 logic.
    hdr.ipv4.ttl = 64;

    // Count host injections so the assertion only fires after the second pass.
    phase += 1;
  }
}

global {
  queue_capacity = 1;
  env_thread = false;
  host_eager = true;
  deterministic_scheduler = true;
  max_steps = 6;

  int phase = 0;

  assert {
    // After the second packet of the same non-colliding flow, the accumulated
    // length feature must not have wrapped to zero.  The write guard keeps this
    // from passing through a stale mirror value: a counterexample must include
    // an actual write of zero to the feature register.
    (phase < 2)
      || !(flowrest_Ingress_reg_pkt_len_total__wrote_any
           && flowrest_Ingress_reg_pkt_len_total__last_value == 0);
  };
}
