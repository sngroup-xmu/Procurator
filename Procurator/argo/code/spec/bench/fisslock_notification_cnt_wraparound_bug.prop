// FissLock (P4_16 / TNA): premature agent transfer after 8-bit notification counter wraparound.
//
// Background (from `ingress.p4` + `counter.p4`):
//   - Each ACQUIRE (shared) increments `notification_cnt`.
//   - TRANSFER/FREE (old_mode=LOCK_SHARED) compares `notification_cnt` with `hdr.lock.ncnt`:
//       - mismatch => assume there are packets still "in the network" => push back (skip transfer)
//       - match    => allow transfer and reset the counter
//
// Bug (functional-consistency, triggered by wraparound):
//   - The notification counter is only 8 bits (`bit<8>`), so after 256 ACQUIREs it wraps to 0.
//   - A TRANSFER with a stale `hdr.lock.ncnt == 0` becomes indistinguishable from a fresh counter==0,
//     so the switch can incorrectly allow TRANSFER and change the agent even though the safety check
//     was intended to prevent "in-flight packets" from being stranded at the old agent.
//
// This benchmark is designed for the integrated wraparound pipeline (ENTRY -> CONFIRM -> CLOSURE):
//   - confirm fast-forwards `notification_cnt[0]` to MAX (255)
//   - then runs one pump packet (ACQUIRE) to overflow MAX->0
//   - then runs one functional packet (TRANSFER) and checks the (violated) expectation
//
// Any UNSAFE must be validated by witness rerun and (for wraparound) certified by closure_check==SAFE.

import sw from "../../dataset/fisslock/p4/switch.p4";

topology {}

host client {
  connect sw;
  env {
    // Parser reachability: Ethernet/IPv4/UDP/lock.
    hdr.ethernet.valid = true;
    hdr.ipv4.valid = true;
    hdr.udp.valid = true;
    hdr.lock.valid = true;

    hdr.ethernet.l3_proto = 2048;  // TYPE_IPV4
    // Reduce nondet state: irrelevant fields for the lock-fastpath.
    // (These fields are still present in the translated model and can bloat SMT.)
    hdr.ethernet.dst_mac = 0;
    hdr.ipv4.l4_proto = 17;        // TYPE_UDP
    hdr.ipv4.hdr_cksum = 0;
    hdr.udp.dst_port = 20001;      // UDP_PORT_SERVER (also accepts UDP_PORT_CLIENT)
    hdr.roce.opcode = 0;
    hdr.roce.psn = 0;

    // Fresh packet (resubmit path rejects).
    ig_intr_md.resubmit_flag = 0;

    // Keep all per-lock indices stable and in-range (CounterTable_1 / LockOperation_1).
    hdr.lock.id = 0;
    hdr.lock.mode = 0;      // LOCK_SHARED
    hdr.lock.old_mode = 0;  // LOCK_SHARED

    // Stale counter value: this is safe to accept only if the true counter has not advanced.
    // After wraparound (256 increments), this becomes ambiguous and can lead to a wrong transfer.
    hdr.lock.ncnt = 0;

    // Ensure we can observe whether the agent transfer happened.
    hdr.lock.transferred = 0;
    hdr.lock.granted = 0;
    hdr.lock.multicasted = 0;
    hdr.lock.machine_id = 1; // new agent candidate
    hdr.lock.agent = 2;      // old agent (pushback should preserve this)
    hdr.lock.task_id = 0;
    hdr.lock.wq_size = 0;

    // Two-phase env script controlled by a DSL boolean `pump_mode`:
    //   - pump_mode=true  => ACQUIRE (monotone +1) to overflow the 8-bit counter
    //   - pump_mode=false => TRANSFER (functional check)
    if (pump_mode) {
      hdr.lock.type = 1; // ACQUIRE
    } else {
      hdr.lock.type = 5; // TRANSFER
    }
  }
}

global {
  queue_capacity = 1;
  env_thread = false;
  host_eager = true;
  deterministic_scheduler = true;
  max_steps = 6; // host inject + two passes

  // Default to the pumping prefix; wraparound-confirm will switch it after overflow.
  bool pump_mode = true;

  // Help Ultimate simplify huge quantified register initializations:
  // all register accesses in this spec are at lock_id/index == 0.
  assume {
    sw_hdr.lock.id == 0;
    sw_ig_md.lock_index == 0;
    sw_ig_md.lock_out_of_range == 0;
  };

  // Functional check:
  // If we are in the TRANSFER phase and the notification counter is observed as 0,
  // treat this as an overflow event under our wraparound pipeline (MAX->0).
  // In that case, allowing TRANSFER is unsafe (the stale ncnt==0 should have been rejected).
  assert {
    pump_mode
      || (sw_IngressPipe_CounterTable_1_notification_cnt_1[0] != 0)
      || (sw_hdr.lock.transferred == 0);
  };
}
