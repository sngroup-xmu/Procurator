// NetChain bug reproduction attempt (DSL -> Boogie -> Ultimate/GemCutter).
//
// This spec is derived from the Promela artifact in:
//   Procurator/argo/code/results/netchain_backup_0116/main_model.pml
//
// Key points:
// - Traffic model: host_h1 injects write requests to s1 with fixed overlay/ipv4 fields and keys in {2024,2025,2027,2028}
// - Property: sequence monotonicity across replicas:
//     [](s1_sequence_reg_0[0] >= s2_sequence_reg_0[0] && s2_sequence_reg_0[0] >= s3_sequence_reg_0[0])
//
// NOTE: Our current Boogie backend encodes safety checks as `assert` evaluated on every pass.

import s1 from "/mnt/e/p4-verify/Procurator/argo/code/dataset/Netchain/netchain_16.p4" entries "/mnt/e/p4-verify/Procurator/argo/code/dataset/Netchain/commands_1.txt";
import s2 from "/mnt/e/p4-verify/Procurator/argo/code/dataset/Netchain/netchain_16.p4" entries "/mnt/e/p4-verify/Procurator/argo/code/dataset/Netchain/commands_2.txt";
import s3 from "/mnt/e/p4-verify/Procurator/argo/code/dataset/Netchain/netchain_16.p4" entries "/mnt/e/p4-verify/Procurator/argo/code/dataset/Netchain/commands_3.txt";

topology {
  link s1 -> s2 ALL;
  link s2 -> s3 ALL;
}

node s1 {
  external_input = true;

  // Host traffic model (nondet + constraints):
  // - Packet fields are havoc'd nondeterministically by the harness.
  // - Here we only constrain them to match the host_h1 shape from Promela artifacts.
  assume {
    hdr.ethernet.etherType == 2048;
    hdr.ipv4.srcAddr == 1;
    hdr.ipv4.dstAddr == 167797761;

    // Boogie emits overlay stacks as numeric segments (overlay.0/overlay.1/...)
    hdr.overlay.0.swip == 167797761;
    hdr.overlay.1.swip == 167797762;
    hdr.overlay.2.swip == 167797763;
    hdr.overlay.3.swip == 0;

    hdr.nc_hdr.op == 12; // NC_WRITE_REQUEST

    // The Promela client sends 4 keys: 2024, 2025, 2027, 2028 (i=0,1,3,4).
    // We constrain key/value to that set and enforce value==key.
    // NOTE: bool_expr cannot contain a top-level `||` in this DSL; wrap the whole disjunction in parentheses.
    ((((hdr.nc_hdr.key == 2024) || (hdr.nc_hdr.key == 2025)) || (hdr.nc_hdr.key == 2027)) || (hdr.nc_hdr.key == 2028));
    // NOTE: In P4B Boogie, nc_hdr.value may be wider than nc_hdr.key (e.g., bv128 vs bv32).
    // Avoid a width-mismatch constraint here; we can refine later if needed.
  };
}

node s2 {}
node s3 {}

global {
  // Keep queue small; the Boogie harness uses a single-slot mailbox for packet fields.
  queue_capacity = 1;

  // Property (ported from Promela ltl consistency):
  // Promela: [](s1_sequence_reg_0[0] >= s2_sequence_reg_0[0] && s2_sequence_reg_0[0] >= s3_sequence_reg_0[0])
  //
  // In our Boogie pipeline, global assert blocks are checked on every pass.
  assert {
    (s1_sequence_reg_0[0] >= s2_sequence_reg_0[0]) && (s2_sequence_reg_0[0] >= s3_sequence_reg_0[0]);
  };
}


