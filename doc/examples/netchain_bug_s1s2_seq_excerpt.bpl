  s2_hdr.nc_hdr.seq := s1_hdr.nc_hdr.seq;
  s2_hdr.nc_hdr.key := s1_hdr.nc_hdr.key;
  s2_hdr.nc_hdr.value := s1_hdr.nc_hdr.value;
  s2_hdr.nc_hdr.vgroup := s1_hdr.nc_hdr.vgroup;
  s2_hdr.tcp.valid := s1_hdr.tcp.valid;
