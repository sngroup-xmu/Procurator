  s2_hdr.overlay.last.swip := s1_hdr.overlay.last.swip;
  s2_hdr.overlay.0.valid := s1_hdr.overlay.0.valid;
  s2_hdr.overlay.0.swip := s1_hdr.overlay.0.swip;
