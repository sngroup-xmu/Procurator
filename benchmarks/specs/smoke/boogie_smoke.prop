// Minimal Boogie E2E smoke spec (DSL -> P4->Boogie -> concurrent harness).
//
// Notes:
// - Uses a repo-shipped P4_16 program (`dataset/ipv4/basic.p4`) for each node.
// - Intended to be compiled with:
//     ./src/bin/procurator compile \
//       --spec benchmarks/specs/smoke/boogie_smoke.prop \
//       --backend boogie \
//       --out /tmp/boogie_smoke.bpl \
//       --p4b-bin src/p4b/source/build-host/backends/verify/p4c-translator \
//       --work-dir /tmp/boogie_smoke.work
//

import s1 from "../../datasets/ipv4/basic.p4";
import s2 from "../../datasets/ipv4/basic.p4";

topology {
  link s1 -> s2;
  link s2 -> s1;
}

node s1 {
  external_input = true;
  assert {
    s1_inbox_count >= 0;
  };
}

node s2 {
}

global {
  queue_capacity = 2;
}
