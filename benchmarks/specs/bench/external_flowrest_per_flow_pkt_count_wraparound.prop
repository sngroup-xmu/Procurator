// External candidate: Flowrest INFOCOM 2023 per-flow Random Forest inference.
//
// Candidate bug shape:
//   reg_pkt_count is an 8-bit per-flow packet counter.  After the counter wraps,
//   a long-lived flow can be observed with a small packet count again, which may
//   send the flow back through the warm-up / classification path.
//
// The external P4 source is kept unchanged.  Unsupported TNA/Tofino syntax must
// be handled in P4B rather than by modifying dataset/external_flowrest_per_flow.

import flowrest from "../../datasets/external_flowrest_per_flow/unsw_per_flow_16_classes.p4";

topology {}

host io {
  connect flowrest;
  env {
    hdr.ethernet.valid = true;
    hdr.ipv4.valid = true;
    hdr.tcp.valid = true;
    hdr.udp.valid = false;
    hdr.recirc.valid = false;

    hdr.ethernet.ether_type = 2048; // TYPE_IPV4
    hdr.ipv4.protocol = 6;          // TCP
    hdr.ipv4.total_len = 64;
    hdr.ipv4.src_addr = 167772161;  // 10.0.0.1
    hdr.ipv4.dst_addr = 167772162;  // 10.0.0.2
    hdr.tcp.src_port = 1234;
    hdr.tcp.dst_port = 443;
    meta.hdr_srcport = 1234;
    meta.hdr_dstport = 443;

    ig_intr_md.resubmit_flag = 0;
    ig_prsr_md.global_tstamp = 1;

    // Keep a stable baseline so a ttl=128 outcome is attributable to the P4 logic.
    hdr.ipv4.ttl = 64;
  }
}

global {
  queue_capacity = 1;
  env_thread = false;
  host_eager = true;
  deterministic_scheduler = true;
  max_steps = 6;

  // Default to the pump prefix; wraparound-confirm may flip this for suffix checks.
  bool pump_mode = true;

  assert {
    pump_mode
      || (flowrest_meta.is_first != 0)
      || (flowrest_meta.is_hash_collision != 0)
      || (flowrest_meta.pkt_count != 1)
      || (flowrest_hdr.ipv4.ttl != 128);
  };
}
