// Gecko bug #3: write arrives before timer is active.
// Model: if a write occurs before any timer packet, mark it as a violation.

import ta from "../../datasets/gecko/timer_a.json" entries "../../datasets/gecko/control/a.txt";
import tb from "../../datasets/gecko/timer_b.json" entries "../../datasets/gecko/control/b.txt";

topology {
  link ta -> tb ALL;
}

host io {
  connect ta;
  env {
    hdr.ethernet.valid = true;
    hdr.ethernet.ether_type = 21845;
    hdr.albion.valid = true;
    // Reduce irrelevant branching/state: keep register indices and address fields stable.
    // (Put these in host.env rather than node.assume so they constrain host injection too.)
    hdr.albion.CS_id_1 = 0;
    hdr.albion.CS_id_2 = 0;
    hdr.albion.CS_id_3 = 0;
    hdr.albion.CS_offset_1 = 0;
    hdr.albion.CS_offset_2 = 0;
    hdr.albion.CS_offset_3 = 0;
    hdr.albion.address_h = 0;
    hdr.albion.address_l = 0;
    hdr.albion.index = 0;
    hdr.albion.num = 0;
    hdr.albion.port = 0;
    hdr.albion.request_id_high = 0;
    hdr.albion.request_id_low = 0;
    hdr.albion.time = 0;
    if (phase == 0) {
      hdr.albion.operation = 10;
      phase = 1;
    } else {
      hdr.albion.operation = 100;
    }
    if (hdr.albion.operation == 100) {
      hdr.albion_timer.valid = true;
      hdr.albion_data.valid = false;
    } else {
      hdr.albion_timer.valid = false;
      // Write requests do not carry albion_data in our abstraction.
      hdr.albion_data.valid = false;
    }
  }
}

node ta {
  external_input = false;
  assume {
    hdr.ethernet.ether_type == 21845;
    (hdr.albion.operation == 10 || hdr.albion.operation == 100);
  };
  if (hdr.albion.operation == 100) {
    timer_active = 1;
  }
  if (hdr.albion.operation == 10 && timer_active == 0) {
    bad = 1;
  }
  // Record switch->client packaging (port 144) for trace sanity.
  if (ig_tm_md.ucast_egress_port == 144) {
    client_seen = 1;
  }
}

node tb {
}

global {
  queue_capacity = 1;
  deterministic_scheduler = true;
  env_thread = false;
  host_eager = true;
  max_steps = 4;
  int timer_active = 0;
  int bad = 0;
  int client_seen = 0;
  int phase = 0;
  // Help the Boogie post-pass eliminate quantified register initializations by
  // making the bv32 index domain explicit.
  assume {
    ta_hdr.albion.CS_id_1 == 0;
    ta_hdr.albion.CS_id_2 == 0;
    ta_hdr.albion.CS_id_3 == 0;
    ta_hdr.albion.CS_offset_1 == 0;
    ta_hdr.albion.CS_offset_2 == 0;
    ta_hdr.albion.CS_offset_3 == 0;
    ta_hdr.albion.address_h == 0;
    ta_hdr.albion.address_l == 0;
    ta_hdr.albion.index == 0;
    ta_hdr.albion.num == 0;
    ta_hdr.albion.port == 0;
    ta_hdr.albion.request_id_high == 0;
    ta_hdr.albion.request_id_low == 0;
    ta_hdr.albion.time == 0;
    tb_hdr.albion.CS_id_1 == 0;
    tb_hdr.albion.CS_id_2 == 0;
    tb_hdr.albion.CS_id_3 == 0;
    tb_hdr.albion.CS_offset_1 == 0;
    tb_hdr.albion.CS_offset_2 == 0;
    tb_hdr.albion.CS_offset_3 == 0;
    tb_hdr.albion.address_h == 0;
    tb_hdr.albion.address_l == 0;
    tb_hdr.albion.index == 0;
    tb_hdr.albion.num == 0;
    tb_hdr.albion.port == 0;
    tb_hdr.albion.request_id_high == 0;
    tb_hdr.albion.request_id_low == 0;
    tb_hdr.albion.time == 0;
  };
  assert {
    bad == 0;
  };
}
