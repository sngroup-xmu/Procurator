// DistCache (max-env): check power-of-two-choice consistency.
// Uses internal P4 temporaries spineload_0 / leafload_0 computed in poweroftwochoice().

import clientTrack from "../../datasets/distcache/clientrackswitch/partitionswitch.p4" entries "../../datasets/distcache/clientrackswitch/clienttrack_entries.txt";
import leaf        from "../../datasets/distcache/leafswitch/netcache.p4" entries "../../datasets/distcache/leafswitch/flow_entries.txt";
import spine       from "../../datasets/distcache/spineswitch/spineswitch.p4" entries "../../datasets/distcache/spineswitch/spine_entries.txt";

topology {
  link clientTrack -> leaf 1;
  link clientTrack -> spine 2;
  link leaf        -> spine 1;
  link leaf        -> clientTrack 2;
  link spine       -> leaf 1;
  link spine       -> clientTrack 2;
}

node clientTrack {
  external_input = true;
  // Restrict inputs to the P2C request path:
  // - Parser reaches `parse_op` on reserved UDP port 5008.
  // - `poweroftwochoice_tbl` hits `optype == 0x30` (48) and sets `meta.is_spine`.
  assume {
    // Parser reachability: make `hdr.op_hdr` valid.
    hdr.ethernet_hdr.valid == true;
    hdr.ipv4_hdr.valid == true;
    hdr.udp_hdr.valid == true;
    hdr.op_hdr.valid == true;
    hdr.ethernet_hdr.etherType == 2048; // 0x0800 IPv4
    hdr.ipv4_hdr.protocol == 17;        // UDP
    hdr.udp_hdr.dstPort == 5008;
    hdr.op_hdr.optype == 48;
  };
}
node leaf {}
node spine {}

global {
  queue_capacity = 3;
  deterministic_scheduler = true;
  // If leafload > spineload => choose spine (meta.is_spine == 1), else choose leaf (0).
  assert {
    ((clientTrack_leafload_0 <= clientTrack_spineload_0) || (clientTrack_meta.is_spine == 1));
    ((clientTrack_leafload_0 > clientTrack_spineload_0) || (clientTrack_meta.is_spine == 0));
  };
}
