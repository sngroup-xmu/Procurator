// P4xos (max-env): safety property from Promela ltl register_access_security.
// external_input nodes are fully nondet under --env max.

import leader from "../../datasets/P4xos/leader.p4";
import acceptor0 from "../../datasets/P4xos/acceptor.p4";
import acceptor1 from "../../datasets/P4xos/acceptor.p4";
import acceptor2 from "../../datasets/P4xos/acceptor.p4";
import learner from "../../datasets/P4xos/learner.p4";

topology {
  // P4xos forwarding is table-driven; allow max-env inputs on acceptors directly.
}

node leader { external_input = true; }
node acceptor0 { external_input = true; }
node acceptor1 { external_input = true; }
node acceptor2 { external_input = true; }
node learner {}

global {
  queue_capacity = 3;
  assert {
    acceptor0_hdr.paxos.inst < 300;
    acceptor1_hdr.paxos.inst < 300;
    acceptor2_hdr.paxos.inst < 300;
  };
}
