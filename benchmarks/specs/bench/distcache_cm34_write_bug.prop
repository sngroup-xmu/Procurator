// DistCache (leaf-only): CM3/CM4 register write wiring bug.
//
// Intended behavior (Count-Min Sketch hot-key detection building block):
//   - access_cm{1..4}_tbl updates the corresponding cm{1..4}_reg bucket.
//
// Bug (copy/paste in `p4src/regs/cm.p4`):
//   - update_cm3/update_cm4 write into cm1_reg instead of cm3_reg/cm4_reg.
//
// Property idea:
//   - After one leaf pipeline pass, both cm3_reg/cm4_reg must have been written at least once.
//   - We check this via dslc's Boogie-level register instrumentation:
//       `<node>_<reg>__wrote_any`
//     (node prefix avoids collisions in multi-node specs).

import leaf from "../../datasets/distcache/leafswitch/netcache.p4"
  entries "./distcache_leaf_cm_hotness_entries_min.txt";

topology {}

host io {
  connect leaf;
  env {
    // Stay on the "normal" egress path (no bypass), and pick a deterministic CM bucket.
    meta.bypass_egress = 0;

    hdr_eg.inswitch_hdr.valid = true;
    hdr_eg.inswitch_hdr.hashval_for_cm3 = 0;
    hdr_eg.inswitch_hdr.hashval_for_cm4 = 0;
    hdr_eg.inswitch_hdr.hot_threshold = 1;

    // Keep the packet type stable (GETREQ_INSWITCH-like) to reduce nondeterminism in other tables.
    hdr_eg.op_hdr.optype = 4;
    hdr_eg.shadowtype_hdr.shadowtype = 4;
  }
}

global {
  queue_capacity = 1;
  env_thread = false;
  host_eager = true;
  deterministic_scheduler = true;
  // Current sequential harness layout:
  //   step0 host_send, step1 host_recv, step2 node_pass(assert checked here), step3 next host_send.
  // This bug is fully exposed by step2, so use 3 to avoid one irrelevant extra step.
  max_steps = 3;

  assert {
    leaf_netcacheEgress_cm3_reg__wrote_any && leaf_netcacheEgress_cm4_reg__wrote_any;
  };
}
