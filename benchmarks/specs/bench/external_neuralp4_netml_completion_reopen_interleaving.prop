// NeuralP4 (NOMS 2025 artifact): completion-reset reopen candidate.
//
// The ANN ingress stores the received-stimulus bitmap and count in one global
// slot.  When a neuron receives all expected stimuli, it forwards the packet and
// immediately resets reg_received_stimuli/reg_n_received_stimuli to zero.  A
// later duplicate stimulus for the same run/neuron can then be accepted again
// as if the neuron had never seen it.

import ann from "../../datasets/external_neuralp4_noms25/NeuralP4/p4-vm/netml-iot-16x32x2-q4-4/code/ANN.p4";

topology {}

node ann {
  int processed = 0;
  assume {
    MyIngress_tab_expected_stimuli.action_run
      == MyIngress_tab_expected_stimuli.action.MyIngress_set_expected_stimuli;
    MyIngress_tab_expected_stimuli.MyIngress_set_expected_stimuli.expected_stimuli_1 == 1;

    MyIngress_tab_agg_func.action_run
      == MyIngress_tab_agg_func.action.MyIngress_set_agg_func;
    MyIngress_tab_agg_func.MyIngress_set_agg_func.agg_func_1 == 2; // FUNC_IDENTITY

    MyIngress_tab_n_expected_stimuli.action_run
      == MyIngress_tab_n_expected_stimuli.action.MyIngress_set_n_expected_stimuli;
    MyIngress_tab_n_expected_stimuli.MyIngress_set_n_expected_stimuli.n_expected_stimuli_1 == 1;

    MyIngress_tab_neuron_id.action_run
      == MyIngress_tab_neuron_id.action.MyIngress_set_neuron_id;
    MyIngress_tab_neuron_id.MyIngress_set_neuron_id.neuron_id_1 == 0;

    MyIngress_tab_activation_func.action_run
      == MyIngress_tab_activation_func.action.MyIngress_set_activation_func;
    MyIngress_tab_activation_func.MyIngress_set_activation_func.activation_func_1 == 2; // FUNC_IDENTITY

    MyIngress_ann_forward.action_run == MyIngress_ann_forward.action.MyIngress_mcast;
    MyIngress_ann_forward.MyIngress_mcast.mgroup_1 == 1;
  };
  if (pkt_external && hdr.ann.valid) {
    processed += 1;
  }
}

host io {
  connect ann;
  env {
    hdr.ethernet.valid = true;
    hdr.ann.valid = true;
    hdr.ethernet.etherType = 34997; // ET_ANN = 0x88B5

    hdr.ann.run_id = 7;
    hdr.ann.neuron_id = 0;
    hdr.ann.slack = 0;
    hdr.ann.data_1 = 1;
    hdr.ann.data_2 = 2;
    hdr.ann.data_3 = 3;
    hdr.ann.data_4 = 4;
    hdr.ann.data_5 = 5;
    hdr.ann.data_6 = 6;
    hdr.ann.data_7 = 7;
    hdr.ann.data_8 = 8;
    hdr.ann.data_9 = 9;
    hdr.ann.data_10 = 10;
    hdr.ann.data_11 = 11;
    hdr.ann.data_12 = 12;
    hdr.ann.data_13 = 13;
    hdr.ann.data_14 = 14;
    hdr.ann.data_15 = 15;
    hdr.ann.data_16 = 16;
    hdr.ann.data_17 = 17;
    hdr.ann.data_18 = 18;
    hdr.ann.data_19 = 19;
    hdr.ann.data_20 = 20;
    hdr.ann.data_21 = 21;
    hdr.ann.data_22 = 22;
    hdr.ann.data_23 = 23;
    hdr.ann.data_24 = 24;
    hdr.ann.data_25 = 25;
    hdr.ann.data_26 = 26;
    hdr.ann.data_27 = 27;
    hdr.ann.data_28 = 28;
    hdr.ann.data_29 = 29;
    hdr.ann.data_30 = 30;
    hdr.ann.data_31 = 31;
    hdr.ann.data_32 = 32;
  }
}

global {
  queue_capacity = 1;
  deterministic_scheduler = true;
  env_thread = false;
  host_eager = true;
  max_steps = 6;

  assert {
    (ann_dsl_processed < 2)
      || !(ann_MyIngress_reg_received_stimuli__wrote_any
           && ann_MyIngress_reg_n_received_stimuli__wrote_any
           && ann_MyIngress_reg_run_id__last0_value == 7
           && ann_MyIngress_reg_received_stimuli__last0_value == 0
           && ann_MyIngress_reg_n_received_stimuli__last0_value == 0
           && !ann_drop);
  };
}
