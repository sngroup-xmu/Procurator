// DINC (CoNEXT'23 artifact): distributed in-network ML pipeline smoke.
//
// This imports the BMv2 test-environment nodes generated by DINC for a
// distributed decision-tree inference pipeline. The path below follows a small
// subtree of the DINC fat-tree example:
//   host -> s2 (feature0/1 coding) -> s1 (feature2/3 coding) -> s0 (decision)
//
// This spec is intentionally a compile/smoke baseline for external-system
// onboarding. Bug-finding specs should build on it with tighter assertions.

import s2 from "../../datasets/external/DINC/P4/s2.p4"
  entries "../../datasets/external/DINC/commands/s2.txt";
import s1 from "../../datasets/external/DINC/P4/s1.p4"
  entries "../../datasets/external/DINC/commands/s1.txt";
import s0 from "../../datasets/external/DINC/P4/s0.p4"
  entries "../../datasets/external/DINC/commands/s0.txt";

topology {
  link s2 -> s1 1;
  link s1 -> s0 1;
}

node s2 {
  external_input = true;

  assume {
    hdr.ethernet.valid == true;
    hdr.ipv4.valid == true;
    hdr.DINC.valid == true;
    hdr.DINC_meta.valid == true;

    hdr.ethernet.etherType == 4660; // TYPE_DINC = 0x1234
    hdr.ipv4.ttl == 64;
    hdr.ipv4.dstAddr == 167772414; // 10.0.0.254, routed toward s1/s0

    // Start with an unsliced DINC metadata packet. s2 should encode feature0/1
    // when E_bitmap[0] is not set, then downstream nodes fill later slices.
    hdr.DINC.E_bitmap == 0;
    hdr.DINC_meta.storage0 == 0;
    hdr.DINC_meta.storage1 == 0;
    hdr.DINC_meta.storage2 == 0;
    hdr.DINC_meta.storage3 == 0;
  };
}

node s1 {}
node s0 {}

global {
  queue_capacity = 1;
  deterministic_scheduler = true;
  max_steps = 4;

  // Smoke-level sanity: the source packet remains on the DINC path. Stronger
  // end-to-end decision properties should add an explicit DSL phase/observed flag
  // so they only inspect downstream node state after that node has processed a
  // packet.
  assert {
    s2_hdr.DINC.valid == true;
  };
}
