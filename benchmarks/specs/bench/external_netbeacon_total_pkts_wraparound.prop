// External candidate: NetBeacon in-network traffic classification pipeline.
//
// Candidate bug shape:
//   Register_total_pkts is a 16-bit per-flow packet counter.  The steady
//   existing-flow path increments it by one and uses total_pkts to trigger the
//   flow-level classifier at fixed checkpoints.  A wrap from 65535 to 0 makes a
//   long-lived flow look like an early flow again.
//
// This spec is intended for the wraparound pipeline.  Count it as a wraparound
// bug only with a certified manifest: ENTRY and CONFIRM UNSAFE plus CLOSURE
// SAFE for the inferred projection.

import nb from "../../datasets/external_netbeacon_sec23/NetBeacon/switch/data_plane/switch.p4";

topology {}

node nb {
  external_input = true;

  assume {
    hdr.ethernet.valid == true;
    hdr.ipv4.valid == true;
    hdr.tcp.valid == true;
    hdr.udp.valid == false;

    hdr.ethernet.ether_type == 2048; // TYPE_IPV4
    hdr.ipv4.protocol == 6;          // TCP
    hdr.ipv4.ihl == 5;
    hdr.ipv4.frag_offset == 0;
    hdr.ipv4.total_len == 64;
    hdr.ipv4.src_addr == 167772161;  // 10.0.0.1
    hdr.ipv4.dst_addr == 167772162;  // 10.0.0.2
    hdr.ipv4.ttl == 64;
    hdr.tcp.src_port == 1234;
    hdr.tcp.dst_port == 443;
    hdr.tcp.window == 1;
    hdr.tcp.data_offset == 5;

    ig_intr_md.resubmit_flag == 0;
    ig_intr_md.ingress_port != 68;   // not recirculate_port
    ig_prsr_md.global_tstamp == 1048576;

    SwitchIngress_Flow_result.action_run == SwitchIngress_Flow_result.action.noaction_19;
    SwitchIngress_Update_total_pkts_table.action_run == SwitchIngress_Update_total_pkts_table.action.SwitchIngress_Update_total_pkts;
  };
}

global {
  queue_capacity = 1;
  deterministic_scheduler = true;

  assert {
    !(nb_SwitchIngress_Update_total_pkts_table.action_run == nb_SwitchIngress_Update_total_pkts_table.action.SwitchIngress_Update_total_pkts
      && nb_SwitchIngress_Register_total_pkts__wrote_any
      && nb_SwitchIngress_Register_total_pkts__last_value == 0);
  };
}
