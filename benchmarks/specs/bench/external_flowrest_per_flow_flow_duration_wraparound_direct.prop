// External candidate: Flowrest INFOCOM 2023 per-flow Random Forest inference.
//
// Bug shape:
//   reg_flow_duration is a 32-bit accumulated duration feature. With repeated
//   packets for the same flow, timestamp choices can make a non-zero IAT wrap
//   the accumulated duration back to 0.
//
// The assertion excludes the trivial first-packet/no-IAT case: a violation must
// be a non-first packet, with non-zero IAT, and an actual zero write.

import flowrest from "../../datasets/external_flowrest_per_flow/unsw_per_flow_16_classes.p4";

topology {}

node flowrest {
  external_input = true;

  assume {
    hdr.ethernet.valid == true;
    hdr.ipv4.valid == true;
    hdr.tcp.valid == true;
    hdr.udp.valid == false;
    hdr.recirc.valid == false;

    hdr.ethernet.ether_type == 2048; // TYPE_IPV4
    hdr.ipv4.protocol == 6;          // TCP
    hdr.ipv4.total_len == 64;
    hdr.ipv4.src_addr == 167772161;  // 10.0.0.1
    hdr.ipv4.dst_addr == 167772162;  // 10.0.0.2
    hdr.tcp.src_port == 1234;
    hdr.tcp.dst_port == 443;

    ig_intr_md.resubmit_flag == 0;
  };
}

global {
  queue_capacity = 1;
  deterministic_scheduler = true;
  max_steps = 6;

  assert {
    !(flowrest_Ingress_reg_flow_duration__wrote_any
      && flowrest_Ingress_reg_flow_duration__last_value == 0
      && flowrest_meta.is_first != 1
      && flowrest_meta.iat != 0);
  };
}
