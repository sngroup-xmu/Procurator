// External candidate: ETC_NOMS_2024 in-switch encrypted traffic classification.
//
// Source project: https://github.com/nds-group/ETC_NOMS_2024
// Program snapshot is copied into dataset/external_etc_noms2024 without source
// edits. Unsupported TNA syntax/externs must be supported in P4B instead of
// rewriting this dataset.
//
// Candidate bug shape:
//   reg_pkt_count is an 8-bit per-flow packet counter.  It is incremented on
//   every non-collision packet for a tracked flow and used to trigger the ML
//   feature/classification block at pkt_count == 8.  A wrap from 255 to 0 can
//   make an old flow look like an early/unclassified flow again.
//
// This spec keeps the hash/index/register-update path alive.  The wraparound
// pipeline should certify replayability before treating the overflow suffix as
// a real bug witness.

import etc from "../../datasets/external_etc_noms2024/noms_20_5_4.p4";

topology {}

node etc {
  external_input = true;

  assume {
    hdr.ethernet.valid == true;
    hdr.ipv4.valid == true;
    hdr.tcp.valid == true;
    hdr.recirc.valid == false;

    hdr.ethernet.ether_type == 2048; // TYPE_IPV4 = 0x0800
    hdr.ipv4.protocol == 6;          // TCP
    hdr.ipv4.total_len == 64;
    hdr.ipv4.src_addr == 167772161;  // 10.0.0.1
    hdr.ipv4.dst_addr == 167772162;  // 10.0.0.2
    hdr.tcp.src_port == 1234;
    hdr.tcp.dst_port == 443;
    ig_intr_md.resubmit_flag == 0;

    // Drive the tracked-flow table path that sets final_class back to 0 after
    // the parser initializes it to the sentinel value 10.
    Ingress_target_flows_table.action_run == Ingress_target_flows_table.action.Ingress_set_flow_class;
    Ingress_target_flows_table.Ingress_set_flow_class.f_class == 0;
  };
}

global {
  queue_capacity = 1;
  deterministic_scheduler = true;
  max_steps = 2;

  assert {
    !(etc_Ingress_reg_pkt_count__wrote_any
      && etc_Ingress_reg_pkt_count__last_value == 0);
  };
}
