// External candidate: ETC_NOMS_2024 in-switch encrypted traffic classification.
//
// Source project: https://github.com/nds-group/ETC_NOMS_2024
// Program snapshot is copied into dataset/external_etc_noms2024 without source
// edits. The P4B frontend must provide TNA/Tofino compatibility (for example
// __TARGET_TOFINO__) rather than modifying this dataset.
//
// This is an onboarding smoke spec for the single-switch classifier. Bug-finding
// specs should tighten the table/path assumptions and assert on the stateful
// registers such as Ingress_reg_pkt_count or Ingress_reg_pkt_len_total.

import etc from "../../datasets/external_etc_noms2024/noms_20_5_4.p4";

topology {}

node etc {
  external_input = true;

  assume {
    hdr.ethernet.valid == true;
    hdr.ipv4.valid == true;
    hdr.tcp.valid == true;
    hdr.recirc.valid == false;

    hdr.ethernet.ether_type == 2048; // TYPE_IPV4 = 0x0800
    hdr.ipv4.protocol == 6;          // TCP
    hdr.ipv4.src_addr == 167772161;  // 10.0.0.1
    hdr.ipv4.dst_addr == 167772162;  // 10.0.0.2
    hdr.tcp.src_port == 1234;
    hdr.tcp.dst_port == 443;
  };
}

global {
  queue_capacity = 1;
  deterministic_scheduler = true;
  max_steps = 2;

  assert {
    etc_hdr.ipv4.valid == true;
  };
}
