// External candidate: Flowrest INFOCOM 2023 per-flow Random Forest inference.
//
// Bug shape:
//   reg_pkt_len_total is a 16-bit per-flow accumulated packet-length feature.
//   Two 32768-byte packets for the same flow write 0 to the feature register.
//
// This direct single-node spec avoids host scheduling noise. The assertion is
// guarded by the P4B register write mirror, so a counterexample must contain an
// actual zero write to reg_pkt_len_total.

import flowrest from "../../datasets/external_flowrest_per_flow/unsw_per_flow_16_classes.p4";

topology {}

node flowrest {
  external_input = true;

  assume {
    hdr.ethernet.valid == true;
    hdr.ipv4.valid == true;
    hdr.tcp.valid == true;
    hdr.udp.valid == false;
    hdr.recirc.valid == false;

    hdr.ethernet.ether_type == 2048; // TYPE_IPV4
    hdr.ipv4.protocol == 6;          // TCP
    hdr.ipv4.total_len == 32768;     // two packets overflow the 16-bit total
    hdr.ipv4.src_addr == 167772161;  // 10.0.0.1
    hdr.ipv4.dst_addr == 167772162;  // 10.0.0.2
    hdr.tcp.src_port == 1234;
    hdr.tcp.dst_port == 443;

    ig_intr_md.resubmit_flag == 0;
    ig_prsr_md.global_tstamp == 1;
  };
}

global {
  queue_capacity = 1;
  deterministic_scheduler = true;
  max_steps = 4;

  assert {
    !(flowrest_Ingress_reg_pkt_len_total__wrote_any
      && flowrest_Ingress_reg_pkt_len_total__last_value == 0);
  };
}
