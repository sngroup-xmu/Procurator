// Cheetah (NSDI Table 2): Slot Index Collision
//
// Root cause (high-level): The stateful ConnTable uses a fixed-size "free index" pool
// (STATEFUL_SIZE==10) but does not guard against pool exhaustion / pop/push overlap.
// After enough SYN packets, the pool returns the sentinel 0xffff, which is used as a cookie
// index and breaks the per-connection mapping logic.
//
// This spec reproduces the bug by injecting a SYN packet while the ConnTable free-index
// pool is already exhausted (free_indices[*]=0xffff). This state is reachable after enough
// SYN allocations in the original program, but makes the bug easier to trigger within a
// short bounded run.

import s1 from "../../datasets/Cheetah/cheetah-stateful.p4"
  entries "../../datasets/Cheetah/s1-commands-stateful-preexhausted.txt";

topology {
  // Single-switch bug: no topology needed.
}

node s1 {
  external_input = true;
  env {
    // Force parser reachability / header validity for the simplified Cheetah model.
    hdr.ethernet.valid = true;
    hdr.ipv4.valid = true;
    hdr.tcp.valid = true;
    hdr.timestamp.valid = true;

    // Client -> VIP packet.
    // NOTE: DSL numeric literals are decimal-only (no 0x...).
    hdr.ipv4.srcAddr = 167772161; // 10.0.0.1
    hdr.ipv4.dstAddr = 167772414; // 10.0.0.254 (VIP)
    hdr.ipv4.protocol = 6;         // TCP

    // Port 10 maps to the first ConnTable bank (see upstream README).
    hdr.tcp.srcPort = 10;
    hdr.tcp.dstPort = 80;

    // Always inject SYN packets to allocate a new cookie.
    hdr.tcp.syn = 1;
    hdr.tcp.fin = 0;

    // Input cookie (will be overwritten on SYN); keep it deterministic.
    hdr.timestamp.tsecr_lsb = 0;

    // Keep the injection port fixed (avoids extra nondet in some parsers).
    standard_metadata.ingress_port = 0;
  }
}

global {
  queue_capacity = 1;
  deterministic_scheduler = true;
  // Deterministic sequential harness schedule:
  //   env_inject -> node_pass (period 2).
  // One packet => 1 env_inject + 1 node_pass = 2 steps.
  max_steps = 2;

  // Safety property:
  // For any client-originated SYN to the VIP, the allocated cookie (tsecr_lsb after the pass)
  // must remain within the ConnTable slot range (< STATEFUL_SIZE == 10).
  assert {
    (!s1_hdr.ipv4.valid)
      // NOTE: `dstAddr` is rewritten to the selected backend server IP on SYN.
      // Guard on the client source IP instead.
      || (s1_hdr.ipv4.srcAddr != 167772161)
      || (!s1_hdr.tcp.valid)
      || (s1_hdr.tcp.syn == 0)
      || (s1_hdr.timestamp.tsecr_lsb < 10);
  };
}
