* text=auto eol=lf

# Preserve upstream/evidence formatting without making git diff --check block on
# historical trailing whitespace in imported artifacts.
artifact/evidence/** -whitespace
benchmarks/datasets/** -whitespace
benchmarks/specs/** -whitespace
third_party/** -whitespace
src/p4b/source/** -whitespace
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.pdf binary
*.zip binary
*.tar binary
*.gz binary
*.tgz binary
*.jar binary
*.class binary
*.so binary
*.dll binary
*.exe binary
